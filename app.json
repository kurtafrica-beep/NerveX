{
  "expo": {
    "name": "Nerve",
    "slug": "nerve",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nervex.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E8EBE5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.nervex.app",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Nerve",
      "shortName": "Nerve",
      "backgroundColor": "#E8EBE5",
      "themeColor": "#E8EBE5",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-web-browser",
      "expo-font",
      "expo-video",
      [
        "expo-audio",
        {
          "microphonePermission": "Nerve uses the microphone when you record a voice note.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Nerve uses the camera when you record a video of yourself.",
          "microphonePermission": "Nerve uses the microphone when you record audio or video.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Nerve uses the microphone when you record a voice note.",
          "speechRecognitionPermission": "Nerve listens for \u201cstart\u201d and \u201cstop\u201d in hands-free mode.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.as",
            "com.google.android.tts"
          ]
        }
      ]
    ],
    "scheme": "nerve",
    "experiments": {
      "baseUrl": "/NerveX"
    }
  }
}
