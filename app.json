{
  "expo": {
    "name": "Nerve",
    "slug": "nerve",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nervex.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F3F0E8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.nervex.app",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      "expo-font",
      "expo-video",
      [
        "expo-audio",
        {
          "microphonePermission": "Nerve uses the microphone when you record a voice note.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Nerve uses the camera when you record a video of yourself.",
          "microphonePermission": "Nerve uses the microphone when you record audio or video.",
          "recordAudioAndroid": true
        }
      ]
    ],
    "scheme": "nerve"
  }
}